@using MyCloset.Frontend.Blazor.Enums
@using MyCloset.Frontend.Blazor.Models
@using MyCloset.Frontend.Blazor.Services
@using MyCloset.Frontend.Blazor.Components.SubComponents
@inject IClothingService ClothingService;
@page "/"

@if (_isLoading)
{
    <div class="h-screen flex items-center justify-center">
    <div class="w-10 h-10 sm:w-12 sm:h-12">
        <LoadingCircle/>
    </div>
    </div>

}
else{
        <div>
        <header >
            <SearchInput Placeholder="Search for clothing..." OnChildClick="SearchByClothingName"/>
            <Dropdown Title="Season" DropdownItems="seasons" />
        </header>

@*         <div class="grid gap-y-4 sm:gap-y-8 md:grid-cols-3 md:gap-2 lg:grid-cols-4 lg:gap-5">
            @foreach (var clothing in Clothes)
            {
                <ClothingItem Clothing="clothing"></ClothingItem>
            }
        </div> *@
        </div>
}
@if (ShowError)
{
    <ErrorAlert ErrorMessage=@ErrorMessage></ErrorAlert>
}

@code {
    public List<ClothingDTO?> Clothes { get; set; } = [];
    public bool ShowError { get; set; }
    public string? ErrorMessage { get; set; }
    private bool _isLoading = true;
    public string? _searchTerm;
    private bool _isInitializing = true;
    private readonly string[] seasons = Enum.GetNames(typeof(Season));  

    protected override async Task OnInitializedAsync()
    {
        await LoadClothes(_searchTerm);
    }

    public async Task LoadClothes(string? searchTerm)
    {
        _isLoading = true;
        ShowError = false;

        try
        {
            var clothingFilters = new ClothingFilter
            (
                _searchTerm, null, null, null, null, null, null, 
                null, null, null
            );

            Clothes = await ClothingService.GetAllClothing(clothingFilters, null, null, null, null);

            if (!Clothes.Any())
            {
                string errorMessage = "The closet is empty...";
                SetError(errorMessage, false, null);
            }
        }
        catch (HttpRequestException ex)
        {
            SetError(ex.Message, true, null);
        }
        catch (Exception ex)
        {
            SetError(ex.Message, true, null);
        }
        finally
        {
            _isLoading = false;
        }
    }

    public void SetError(string errorMessage, bool isHttpMessage, int? statusCode)
    {
        ShowError = true;

        var processedMessage = isHttpMessage
            ? errorMessage.Split('\n').FirstOrDefault()?.Trim()
            : errorMessage;

        ErrorMessage = statusCode.HasValue
            ? $" ({statusCode}): {processedMessage}"
            : $" {processedMessage}";
    }

    public async Task SearchByClothingName(string searchTerm)
    {
        _searchTerm = searchTerm;
        await LoadClothes(string.IsNullOrWhiteSpace(_searchTerm) ? null : _searchTerm);
    }
}
