@using MyCloset.Frontend.Blazor.Models

<div>
    <img src=@RenderImage() class="aspect-square w-full rounded-md bg-gray-200 object-cover group-hover:opacity-75 lg:aspect-auto lg:h-80">
    <div class="mt-4 flex justify-between">
        <div>
            <h3 class="text-sm text-gray-700">
                <a href="#">
                    <span aria-hidden="true" class="absolute inset-0"></span>
                    <span placeholder="enter name">@Clothing.Name</span>
                </a>
            </h3>
            <p 
            placeholder="enter store name" 
            class="mt-1 text-sm text-gray-500" 
            >@Clothing.Store</p>
        </div>
        <div class="flex flex-col">
            <div class="flex items-center">
                <span class="text-sm font-medium text-gray-900">€</span>
                <p
                    placeholder="0"
                    class="text-sm font-medium text-gray-900 ml-1"
                   min=0>@Clothing.Prize</p>
            </div>

            <time datetime=@Clothing.Date 
            class="mt-1 text-sm text-gray-500">@Clothing.Date</time>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public required ClothingDTO Clothing { get; set; }

    public string RenderImage()
    {
        if (Clothing.Images.Any())
            return $"data:{Clothing.Images[0]!.ContentType};base64,{FromByteArrayToBase64String(Clothing.Images[0]!.Data)}";

        return "Images/placeholder_image.png";
    }

    public string FromByteArrayToBase64String(byte[] bytes) => Convert.ToBase64String(bytes);
    
}
