@using Models
@using Enums
@using System.Diagnostics;
@using MyCloset.Frontend.Blazor.Components.SubComponents
@using Services;
@inject IClothingService ClothingService;
@inject NavigationManager navigationHelper;
@page "/add"

@if (ShowSuccess)
{
    <SuccessAlert SuccessText=@_successtext></SuccessAlert>
}
<div class="bg-white">
    <div class="pt-6">
        <!-- Image gallery -->
        <div class="mx-auto mt-6 max-w-2xl sm:px-6 grid max-w-7xl grid-cols-3 gap-4 lg:gap-x-8">

            @for(int i = 0; i < MaxImages; i++)
            {
                int index = i;
                <div>
                    <img src="@RenderImage(index)" class="mb-2 rounded-lg object-cover h-48 md:h-64 w-full" />
                    <div class="flex flex-col lg:flex-row gap-2">
                        <InputFile class="block w-32 text-sm text-gray-500 text-transparent
                                         file:py-2.5 file:px-4
                                         file:rounded-md file:border-0
                                         file:text-sm file:font-semibold
                                         file:bg-blue-50 file:text-blue-700
                                         hover:file:bg-blue-100"
                                   accept="@AllowedImgExtensions"
                                   OnChange="(ev) => UploadImage(ev, index)" />

                        <button @onclick="() => ClearItem(index)"
                                class="!rounded-lg w-24
                                hover:bg-gray-200 text-gray-800
                                       font-semibold py-2.5 px-4 bg-gray-100
                                       transition-colors">
                            Clear
                        </button>
                    </div>
                </div>
            }
        </div>

        <!-- Product info -->
        <div class="mx-auto max-w-2xl px-4 pt-6 pb-16 sm:px-6 lg:grid lg:max-w-7xl lg:grid-cols-3 lg:grid-rows-[auto_auto_1fr] lg:gap-x-8 lg:px-8 lg:pt-16 lg:pb-24">
            <div class="lg:col-span-2 lg:border-r lg:border-gray-200 lg:pr-8">
                <div class="mb-6 transition-all duration-200 hover:bg-gray-50 rounded-lg p-2">
                    <label class="block text-lg font-medium text-gray-700 mb-1">Name</label>
                    <InputText @bind-value="Clothing.Name"
                               placeholder="e.g. 'Denim Jacket'"
                               class="w-full p-3 text-lg sm:text-xl border border-gray-300 rounded-md focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all" />
                </div>

                <div class="mb-6 transition-all duration-200 hover:bg-gray-50 rounded-lg p-2">
                    <label class="block text-lg font-medium text-gray-700 mb-1">Store</label>
                    <InputText @bind-value="Clothing.Store"
                               placeholder="e.g. 'Uniqlo'"
                               class="w-full p-3 text-lg sm:text-xl border border-gray-300 rounded-md focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all" />
                </div>

                <div class="mb-6 transition-all duration-200 hover:bg-gray-50 rounded-lg p-2">
                    <label class="block text-lg font-medium text-gray-700 mb-1">Purchase Date</label>
                    <input type="date"
                           @bind-value="Clothing.Date"
                           class="w-full p-3 text-lg sm:text-xl border border-gray-300 rounded-md focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all" />
                </div>
            </div>

            <!-- Options -->
            <div class="lg:row-span-3 lg:mt-0">
                <label class="block text-lg font-medium text-gray-700 mb-1">Prize</label>

                <div class="group relative flex items-center">

                    <span class="absolute left-3 text-2xl font-medium text-gray-500 pointer-events-none">€</span>

                    <InputNumber @bind-value="Clothing.Prize"
                                 placeholder="0.00"
                                 min="0"
                                 step="0.01"
                                 class="w-full pl-10 pr-4 py-3 text-2xl sm:text-3xl border border-gray-300 rounded-lg
           focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500
           [-moz-appearance:_textfield] [&::-webkit-outer-spin-button]:m-0
           [&::-webkit-inner-spin-button]:m-0 [&::-webkit-outer-spin-button]:appearance-none
           [&::-webkit-inner-spin-button]:appearance-none
           transition-all duration-150 hover:border-gray-400" />
                </div>

                <div class="mt-10">
                    <h3 class="text-base font-bold text-gray-900">Color</h3>

                    <fieldset aria-label="Choose a color" class="mt-4">
                        <div class="flex flex-wrap gap-x-3 gap-y-3">
                            @foreach (var color in Enum.GetValues(typeof(Color)))
                            {
                                <label aria-label=@color class="relative -m-0.5 flex cursor-pointer items-center justify-center rounded-full p-0.5 ring-gray-900 focus:outline-none">
                                    <input @onclick="() => ChooseColors((Color)color)" type="radio" name="color-choice" value=@color class="sr-only">
                                    <span aria-hidden="true" class=@GetColorClass((Color)color)></span>
                                </label>      
                            }
                        </div>
                    </fieldset>
                </div>
                <div class="mt-10">
                    <h3 class="text-base font-bold text-gray-900">Type</h3>
                    <fieldset aria-label="Choose a size">
                        <div class="grid grid-cols-4 gap-4 sm:grid-cols-8 lg:grid-cols-4 mt-3">
                            @foreach (var clothingType in Enum.GetValues(typeof(ClothingType)))
                            {

                                <label class=@GetPropertyClass((ClothingType)clothingType)>
                                    <input @onclick="() => ChoosePropertyValue((ClothingType)clothingType)"
                                    type="radio" 
                                    name="size-choice" 
                                    class="sr-only">
                                    <span class="w-full flex items-center justify-center text-center h-full">
                                        @clothingType.ToString().ToUpper()[0]@clothingType.ToString().ToLower().Substring(1)
                                    </span>                                  
                                </label>
                            } 
                        </div>
                    </fieldset>
                </div>
                <div class="mt-10">
                    <h3 class="text-base font-bold text-gray-900">Size</h3>
                    <div class="mt-4">
                        <InputSelect @bind-value="Clothing.Size" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-auto p-2.5">
                            @foreach (var size in Enum.GetValues(typeof(Size)))
                            {
                                <option value=@size>@size</option>
                            }
                        </InputSelect>
                    </div>
                </div>
            </div>

            <div class="mt-10">
                <h3 class="font-bold text-gray-900">Season</h3>

                <fieldset aria-label="Choose a season" class="w-full">
                    <div class="gap-x-4 grid grid-cols-4 sm:grid-cols-8 lg:grid-cols-4 mt-3">
                        @foreach (var season in Enum.GetValues(typeof(Season)))
                        {

                            <label class=@GetPropertyClass((Season)season)>
                                <input 
                                @onclick="() => ChoosePropertyValue((Season)season)" 
                                type="radio" 
                                name="season-choice" 
                                class="sr-only">
                                <span class="w-full flex items-center justify-center text-center h-full">
                                    @season
                                </span>
                            </label>
                        } 
                    </div>
                </fieldset>

                <div class="mt-4">
                    <h3 class="text-base font-bold text-gray-900">Materials</h3>
                    <fieldset aria-label="Choose a size">
                        <div class="grid grid-cols-4 gap-4 sm:grid-cols-8 lg:grid-cols-4 mt-3">
                            @foreach (var material in Enum.GetValues(typeof(Material)))
                            {

                                <label class=@GetPropertyClass((Material)material)>
                                    <input 
                                    @onclick="() => ChoosePropertyValue((Material)material)" 
                                    type="radio" 
                                    name="material-choice" 
                                    class="sr-only">
                                    <span class="w-full flex items-center justify-center text-center h-full">
                                        @material.ToString().ToUpper()[0]@material.ToString().ToLower().Substring(1)
                                    </span>
                                </label>
                            } 
                        </div>
                    </fieldset>
                </div>
                <div class="mt-4">
                    <h3 class="text-base font-bold text-gray-900">Aesthetic</h3>
                    <div>
                    <fieldset aria-label="Choose a size">
                        <div class="grid grid-cols-4 gap-4 sm:grid-cols-8 lg:grid-cols-4 mt-3">
                            @foreach (var aesthetic in Enum.GetValues(typeof(Aesthetic)))
                            {

                                <label class=@GetPropertyClass((Aesthetic)aesthetic)>
                                    <input 
                                    @onclick="() => ChoosePropertyValue((Aesthetic)aesthetic)" 
                                    type="radio" 
                                    name="aesthetic-choice" 
                                    class="sr-only">
                                    <span class="w-full flex items-center justify-center text-center h-full">
                                        @(aesthetic.ToString().ToLower()
                                            .Split('_')
                                            .Select(word => word.First().ToString().ToUpper() + word.Substring(1))
                                            .Aggregate((a, b) => a + " " + b))
                                    </span>
                                </label>
                            } 
                        </div>
                    </fieldset>
                    <div class="mt-8">
                            <button type="submit" @onclick="CreateNewClothing"
                                    class="!rounded-lg w-24 flex w-full items-center justify-center rounded-md border border-transparent bg-indigo-600 px-8 py-3
                                text-lg font-medium text-white hover:bg-indigo-700 focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2
                                focus:outline-none">
                                Add
                            </button>
                        </div>

                    </div>

                </div>

                @if (ShowError)
                {
                    <ErrorAlert ErrorMessage=@ErrorMessage></ErrorAlert>
                }
            </div>
        </div>
    </div>
</div>

@code {

    public CreateClothingDTO Clothing = new CreateClothingDTO();
    public const int MaxImages = 3;
    public CreateImageDTO[] Images= new CreateImageDTO[MaxImages];
    public bool ShowError { get; set; }
    public bool ShowSuccess { get; set; }
    private string _successtext = "Clothing added to closet!";
    public string? ErrorMessage { get; set; }
    // max size 2GB
    private const uint MaxFileSize = 200000000;
    private const string AllowedImgExtensions = "image/jpeg, image/jpg, image/png"; 

    public async Task CreateNewClothing()
    {
        if (Images.Any())
            Clothing.Images = new List<CreateImageDTO>(Images)!;

        try
        {
            await SendCreateClothingRequest();
        }
        catch (HttpRequestException ex)
        {
            await SetError(ex.Message, true, null);
        }
        catch (Exception ex)
        {
            await SetError(ex.Message, true, null);
        }    
    }

    public async Task SendCreateClothingRequest()
    {
        var result = await ClothingService.AddClothing(Clothing);

        if (result.IsSuccessStatusCode)
        {
            await SetSuccess();
        }
        else
        {
            string errorContent = await result.Content.ReadAsStringAsync();
            await SetError(errorContent, true, (int)result.StatusCode);
        }
    }

    protected override void OnInitialized()
    {
        ShowSuccess = false;
    }

    public string RenderImage(int imageIndex)
    {
        if(Images.Any() && Images[imageIndex] is not null)
            return $"data:{Images[imageIndex].ContentType};base64,{Images[imageIndex].Data}";

        return"Images/placeholder_image.png";
    }

    public void ClearItem(int imageIndex)
    {
        if (Images[imageIndex] is not null)
        {
            Images[imageIndex] = null;
            StateHasChanged();
        }
    }

    public async Task UploadImage(InputFileChangeEventArgs eventArgs, int id)
    {
        try
        {
            var file = eventArgs.GetMultipleFiles().FirstOrDefault();
            if (file is not null && file.Size <= MaxFileSize)
            {
                var buffer = new byte[file.Size];
                using (var stream = file.OpenReadStream())
                {
                    await stream.ReadAsync(buffer, 0, buffer.Length);
                }

                var base64String = Convert.ToBase64String(buffer);

                Images[id] = new CreateImageDTO(base64String, file.ContentType, file.ContentType);
            }
            else
            {
                await SetError("File unvalid. Try file less or equal than 2GB", false, null);
            }
        }
        catch (Exception e)
        {
            await SetError(e.Message, true, null);
        }
    }


    public string GetColorClass(Color color)
    {
        var baseClasses = "h-8 w-8 rounded-full border border-black/10 -m-0.5 flex cursor-pointer items-center justify-center p-0.5 focus:outline-none";
        bool isSelected = Clothing.Colors.Contains(color);
        var selectedClasses = isSelected ? "ring ring-offset-1 ring-gray-400" : "";

        return color switch
        {
            Color.BROWN => $"{baseClasses} {selectedClasses} bg-orange-950 hover:bg-orange-800",
            Color.BEIGE => $"{baseClasses} {selectedClasses} bg-stone-400 hover:bg-stone-300",
            Color.WHITE => $"{baseClasses} {selectedClasses} bg-white hover:bg-gray-100",
            Color.BLACK => $"{baseClasses} {selectedClasses} bg-black hover:bg-gray-900",
            Color.BLUE => $"{baseClasses} {selectedClasses} bg-blue-500 hover:bg-blue-400",
            Color.RED => $"{baseClasses} {selectedClasses} bg-red-500 hover:bg-red-400",
            Color.GREEN => $"{baseClasses} {selectedClasses} bg-green-500 hover:bg-green-400",
            Color.PURPLE => $"{baseClasses} {selectedClasses} bg-purple-500 hover:bg-purple-400",
            Color.ORANGE => $"{baseClasses} {selectedClasses} bg-orange-500 hover:bg-orange-400",
            Color.PINK => $"{baseClasses} {selectedClasses} bg-pink-500 hover:bg-pink-400",
            Color.GRAY => $"{baseClasses} {selectedClasses} bg-gray-500 hover:bg-gray-400",
            _ => $"{baseClasses} {selectedClasses} bg-gray-500 hover:bg-gray-400"
        };
    }

    public void ChooseColors(Color color)
    {
        if (!Clothing.Colors.Contains(color)) Clothing.Colors.Add(color);

        else Clothing.Colors.Remove(color);

        StateHasChanged();
    }

    public void ChoosePropertyValue<T>(T property)
    {
        switch (property)
        {
            case Aesthetic aesthetic:
                Clothing.Aesthetic = aesthetic;
                break;
            case Material material:
                Clothing.Material = material;
                break;
            case Season season:
                Clothing.Season = season;
                break;
            case ClothingType clothingType:
                Clothing.Type = clothingType;
                break;
        }

        StateHasChanged();
    }

    public string GetPropertyClass<T>(T property)
    {
        const string baseClass = "border-1 border-gray-900 group relative flex items-center justify-center rounded-md px-4 py-3 text-xs text-gray-900 shadow-sm focus:outline-none sm:flex-1 sm:py-6 h-full";
        
        return property switch
        {
            Aesthetic aesthetic => Clothing.Aesthetic == aesthetic ? $"{baseClass} font-bold bg-gray-300" : $"{baseClass} bg-gray-50 hover:bg-gray-300",
            Material material => Clothing.Material == material ? $"{baseClass} font-bold bg-gray-300" : $"{baseClass} bg-gray-50 hover:bg-gray-300",
            Season season => $"{GetSeasonColor(season)}",
            ClothingType clothingType => Clothing.Type == clothingType ? $"{baseClass} font-bold bg-gray-300" : $"{baseClass} bg-gray-50 hover:bg-gray-300",
            _ => baseClass
        };
    }

    private string GetSeasonColor(Season season)
    {
        var isSelected = Clothing.Season == season;
        const string baseClass = "border border-gray-500 group relative flex cursor-pointer items-center justify-center rounded-md px-4 py-3 text-xs text-gray-900 shadow-sm focus:outline-none sm:flex-1 sm:py-6";

        return season switch
        {
            Season.FALL => isSelected ? $"{baseClass} font-bold bg-amber-200" : $"{baseClass} bg-amber-500 hover:bg-amber-300",
            Season.WINTER => isSelected ? $"{baseClass} font-bold bg-blue-200" : $"{baseClass} bg-blue-500 hover:bg-blue-300",
            Season.SPRING => isSelected ? $"{baseClass} font-bold bg-pink-200" : $"{baseClass} bg-pink-500 hover:bg-pink-300",
            Season.SUMMER => isSelected ? $"{baseClass} font-bold bg-green-200" : $"{baseClass} bg-green-500 hover:bg-green-300",
            _ => baseClass
        };
    }

    private async Task SetSuccess()
    {
        ShowSuccess = true;
        ShowError = false;
        ResetClothing();
        StateHasChanged(); // Force immediate UI update

        await Task.Delay(5000); // wait 5 seconds

        ShowSuccess = false;
        StateHasChanged();
    }

    private void ResetClothing() 
    {
        Clothing = new CreateClothingDTO();
        ResetImages();
    }
    private void ResetImages() => Images = new CreateImageDTO[MaxImages];

    private async Task SetError(string errorMessage, bool isHttpMessage, int? statusCode)
    {
        ShowError = true;
        ShowSuccess = false;

        var processedMessage = isHttpMessage 
            ? errorMessage.Split('\n').FirstOrDefault()?.Trim() 
            : errorMessage;
    
        ErrorMessage = statusCode.HasValue
            ? $" ({statusCode}): {processedMessage}"
            : $" {processedMessage}";
    }
}

