@using MyCloset.Frontend.Blazor.Models

<div class="group">
    <img src="@RenderImage()"
         class="aspect-square w-full rounded-md bg-gray-200 object-cover transition-opacity group-hover:opacity-75"
         alt="@Clothing.Name">
    <div class="mt-2 flex justify-between h-8">
        <div class="min-w-0">
            <h4 class=" font-semibold text-gray-700">
                @Clothing.Name
            </h4>
        </div>
        <div class="flex gap-x-1">
            <span class="lg:text-lg md:text-lg text-xl font-medium text-gray-900">€</span>
            <p class="lg:text-lg md:text-lg text-xl font-medium text-gray-900">
                @Clothing.Prize
            </p>
        </div>
    </div>
    <div class="flex justify-between items-baseline">
        <p class="text-base text-gray-500 md:text-sm lg:text-sm truncate">
            @Clothing.Store
        </p>
        <time datetime="@Clothing.Date"
              class="text-base text-gray-500 md:text-sm lg:text-sm">
            @Clothing.Date
        </time>
    </div>
</div>
@code {
    [Parameter]
    public required ClothingDTO Clothing { get; set; }

    public string RenderImage()
    {
        if (Clothing.Images.Any())
            return $"data:{Clothing.Images[0]!.ContentType};base64,{FromByteArrayToBase64String(Clothing.Images[0]!.Data)}";

        return "Images/placeholder_image.png";
    }

    public string FromByteArrayToBase64String(byte[] bytes) => Convert.ToBase64String(bytes);
  
}
