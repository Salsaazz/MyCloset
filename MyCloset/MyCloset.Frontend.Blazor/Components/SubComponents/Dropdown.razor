<div id="menu" class="relative inline-block w-full border border-gray-300  rounded-lg ">
    <div class="flex justify-between cursor-pointer h-full p-2.5" onclick="@ToggleDropdown">
        <p class="self-center mb-0 font-bold">
            @Title
        </p>
        <svg width="24" height="24" viewBox="0 0 24 24" focusable="false"
        class="fr-ec-icon fr-ec-icon--default fr-ec-filter-pill--icon"
        role="presentation">
        @if (_isOpen)
        {
            <path d="M18.8238 6.09603L17.9048 5.17603L11.9998 11.081L6.09576 5.17603L5.17676 6.09603L11.0808 12L5.17676 17.904L6.09576 18.824L11.9998 12.919L17.9048 18.824L18.8238 17.904L12.9198 12L18.8238 6.09603Z" />
        }
        else
        {
            <path d="M12 19L5 12L7 10L12 15L17 10L19 12L12 19Z" />
        }
        </svg>      
    </div>
    @if (_isOpen)
    {
        <div class="absolute left-0 mt-1 bg-white rounded-md shadow-lg min-w-full w-auto whitespace-nowrap">
            <div class="py-1">
                @foreach (var item in DropdownItems)
                {
                    <div @onclick="() => SelectItem(item)"
                         class="flex justify-between items-center px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 cursor-pointer">
                        <span>@item</span>
                        <input name="input-@item"
                               checked="@_selectedItems.Contains(item)"
                               type="checkbox"
                               class="h-4 w-4 rounded border-gray-300 text-slate-700 focus:ring-slate-700 focus:ring-2 ml-4">
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public required string[] DropdownItems { get; set; } = [];
    [Parameter]
    public required string Title { get; set; }
    private readonly HashSet<string> _selectedItems = new HashSet<string>();
    private bool _isOpen;

    private void ToggleDropdown() => _isOpen = !_isOpen;

    private void SelectItem(string item)
    {
        if (!_selectedItems.Add(item) && item != Title)
        {
            _selectedItems.Remove(item);
        }
    }
}
